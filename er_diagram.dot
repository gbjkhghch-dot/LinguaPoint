digraph ER {
 graph [rankdir=LR, bgcolor="white", splines=polyline, overlap=false, nodesep=.42, ranksep=1.1, fontname="DejaVu Sans"];
 node [shape=record, style="rounded,filled", fillcolor="#eef4fa", color="#43729b", fontname="DejaVu Sans", fontsize=11];
 edge [color="#657d93", fontname="DejaVu Sans", fontsize=10, arrowsize=.7];
 language [label="{Язык | PK id : int\lname : varchar(80) UNIQUE\lcode : varchar(8) UNIQUE\l}"];
 level [label="{Уровень | PK id : int\lFK language_id\lcode : CEFR\lrank : int\l}"];
 profile [label="{Профиль | PK id : int\lFK user_id UNIQUE\lfull_name : varchar(150)\lrole : varchar(12)\l}"];
 currentlevel [label="{Уровень ученика | PK id\lFK student_id\lFK language_id\lFK level_id\lassigned_at : datetime\l}"];
 test [label="{Входной тест | PK id\lFK language_id\ltitle : varchar(150)\lis_active : bool\l}"];
 question [label="{Вопрос теста | PK id\lFK test_id\ltext : text\loptions A–D : varchar\lcorrect_option : char\lpoints : int\l}"];
 band [label="{Шкала баллов | PK id\lFK test_id\lFK level_id\lmin_points : int\lmax_points : int\l}"];
 result [label="{Результат тестирования | PK id\lFK test_id\lFK student_id (NULL)\lFK level_id\lscore : int\lcompleted_at : datetime\l}"];
 answer [label="{Ответ на вопрос | PK id\lFK result_id\lFK question_id\lselected_option : char\l}"];
 grp [label="{Учебная группа | PK id\lFK language_id\lFK level_id\lFK teacher_id\ltitle : varchar(150)\lcapacity : int\lstatus : char\lstart_date : date\l}"];
 schedule [label="{Расписание | PK id\lFK group_id\lweekday : int\lstart_time / end_time : time\lmeeting_url : url\l}"];
 enrollment [label="{Зачисление (M:N) | PK id\lFK student_id\lFK group_id\lenrolled_at : datetime\lUNIQUE(student, group)\l}",fillcolor="#fff0d8",color="#c48d34"];
 homework [label="{Домашнее задание | PK id\lFK group_id\ltitle : varchar(150)\ldescription : text\ldeadline : datetime\l}"];
 submission [label="{Сдача ДЗ | PK id\lFK homework_id\lFK student_id\ltext : text\lsubmitted_at : datetime\lgrade : int?\lcomment : text\l}"];
 user [label="{Django auth.User | PK id\lusername / email\lpassword hash\l}",fillcolor="#e9f5eb"];
 language -> level [label="1 : N"];
 language -> test [label="1 : N"];
 language -> grp [label="1 : N"];
 language -> currentlevel [label="1 : N"];
 user -> profile [label="1 : 0..1"];
 profile -> currentlevel [label="1 : N"];
 level -> currentlevel [label="1 : N"];
 level -> grp [label="1 : N"];
 level -> result [label="1 : N"];
 level -> band [label="1 : N"];
 test -> question [label="1 : N"];
 test -> band [label="1 : N"];
 test -> result [label="1 : N"];
 result -> answer [label="1 : N"];
 question -> answer [label="1 : N"];
 profile -> result [label="1 : N (optional)"];
 profile -> grp [label="1 : N teacher"];
 profile -> enrollment [label="1 : N"];
 grp -> enrollment [label="1 : N"];
 grp -> schedule [label="1 : N"];
 grp -> homework [label="1 : N"];
 homework -> submission [label="1 : N"];
 profile -> submission [label="1 : N"];
}
